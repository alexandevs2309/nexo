FROM rust:1.90-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY migrations ./migrations
RUN cargo build --release --locked --bin basilisco-registry

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /var/lib/basilisco basilisco
WORKDIR /app
COPY --from=build /src/target/release/basilisco-registry /usr/local/bin/basilisco-registry
RUN mkdir -p /var/lib/basilisco/artifacts && chown -R basilisco:basilisco /var/lib/basilisco
USER basilisco
ENV BASILISCO_BIND=0.0.0.0:8080 BASILISCO_ARTIFACTS=/var/lib/basilisco/artifacts
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/basilisco-registry"]
