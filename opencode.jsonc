        { "action": "edit", "resource": "DEVELOPMENT_STATE.md", "effect": "deny" },
        { "action": "edit", "resource": "**/DEVELOPMENT_STATE.md", "effect": "deny" },
        { "action": "shell", "resource": "git reset *", "effect": "deny" },
