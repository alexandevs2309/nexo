# Punto de venta: venta de mostrador con descuento por volumen.
# Se ejecuta con: cd ejemplos/punto_venta && basilisco run main.bsk

usar "lib.bsk" como pv

sea venta = pv.crear_venta()
venta = pv.agregar_item(venta, "cafe", 10, 3.5)
venta = pv.agregar_item(venta, "pan", 20, 1.2)
venta = pv.agregar_item(venta, "leche", 5, 2.0)
venta = pv.agregar_item(venta, "queso", 3, 15.0)
# Línea inválida (cantidad 0): se ignora.
venta = pv.agregar_item(venta, "gratis", 0, 0.0)

pv.imprimir_ticket(venta)

sea total = pv.calcular_total(venta)
sea final = pv.descuento_volumen(total)
mostrar "Total con descuento: "
mostrar final
