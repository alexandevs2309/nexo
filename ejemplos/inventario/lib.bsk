# Biblioteca de inventario BASILISCO.
#
# Modelo: cada producto es [nombre, cantidad, precio].
# Todas las funciones son puras: reciben el inventario y devuelven uno nuevo.

publico funcion crear_inventario() {
  retornar []
}

# Agrega un producto nuevo. Si el nombre ya existe, la cantidad es negativa
# o el precio es negativo, devuelve el inventario sin cambios.
publico funcion agregar_producto(inv, nombre, cantidad, precio) {
  si cantidad < 0 o precio < 0 {
    retornar inv
  }
  si existe_producto(inv, nombre) {
    retornar inv
  }
  retornar agregar(inv, [nombre, cantidad, precio])
}

publico funcion existe_producto(inv, nombre) {
  para cada p en inv {
    si p[0] == nombre {
      retornar verdadero
    }
  }
  retornar falso
}

# Devuelve el producto con ese nombre, o nulo si no existe.
publico funcion buscar_producto(inv, nombre) {
  para cada p en inv {
    si p[0] == nombre {
      retornar p
    }
  }
  retornar nulo
}

# Devuelve la posición del producto, o -1 si no existe.
publico funcion posicion_producto(inv, nombre) {
  sea i = 0
  para cada p en inv {
    si p[0] == nombre {
      retornar i
    }
    i = i + 1
  }
  retornar -1
}

# Cambia la cantidad de un producto. Si no existe o la cantidad es
# negativa, devuelve el inventario sin cambios.
publico funcion actualizar_cantidad(inv, nombre, cantidad) {
  si cantidad < 0 {
    retornar inv
  }
  sea pos = posicion_producto(inv, nombre)
  si pos == -1 {
    retornar inv
  }
  sea actualizado = [nombre, cantidad, inv[pos][2]]
  sea resultado = []
  sea i = 0
  para cada p en inv {
    si i == pos {
      resultado = agregar(resultado, actualizado)
    } sino {
      resultado = agregar(resultado, p)
    }
    i = i + 1
  }
  retornar resultado
}

# Registra una venta: descuenta la cantidad vendida si hay stock
# suficiente. Si no existe el producto o no alcanza el stock, devuelve
# el inventario sin cambios.
publico funcion vender(inv, nombre, cantidad) {
  si cantidad <= 0 {
    retornar inv
  }
  si no existe_producto(inv, nombre) {
    retornar inv
  }
  sea p = buscar_producto(inv, nombre)
  si p[1] < cantidad {
    retornar inv
  }
  retornar actualizar_cantidad(inv, nombre, p[1] - cantidad)
}

# Elimina un producto del inventario. Si no existe, devuelve el
# inventario sin cambios.
publico funcion eliminar_producto(inv, nombre) {
  sea pos = posicion_producto(inv, nombre)
  si pos == -1 {
    retornar inv
  }
  retornar eliminar(inv, pos)
}

# Suma cantidad * precio de todos los productos.
publico funcion valor_total(inv) {
  sea total = 0.0
  para cada p en inv {
    total = total + p[1] * p[2]
  }
  retornar total
}

# Devuelve el producto más caro, o nulo si el inventario está vacío.
publico funcion producto_mas_caro(inv) {
  si longitud(inv) == 0 {
    retornar nulo
  }
  sea mejor = inv[0]
  para cada p en inv {
    si p[2] > mejor[2] {
      mejor = p
    }
  }
  retornar mejor
}

# Cuenta cuántos productos tienen cantidad 0.
publico funcion contar_agotados(inv) {
  sea agotados = 0
  para cada p en inv {
    si p[1] == 0 {
      agotados = agotados + 1
    }
  }
  retornar agotados
}

# Imprime el inventario completo, un producto por bloque.
# Los precios son enteros en céntimos (el JSON no mezcla decimales con
# enteros en la aritmética).
publico funcion listar_productos(inv) {
  para cada p en inv {
    mostrar "- " + p[0]
    mostrar "    cantidad: "
    mostrar p[1]
    mostrar "    precio (céntimos): "
    mostrar p[2]
  }
}
